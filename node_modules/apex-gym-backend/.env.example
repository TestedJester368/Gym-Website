# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Server Port
PORT=3000

# Database
DATABASE_URL=./apex-gym.db

# Admin Demo Credentials (optional, for first-time setup)
ADMIN_EMAIL=admin@apex.com
ADMIN_PASSWORD=ApexAdmin@2024

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key_here

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500

# Rate Limiting (requests per 15-min window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
